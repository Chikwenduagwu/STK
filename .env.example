# GenLayer (Studio) settings are fixed in lib/genlayer/config.ts - no variables needed.

# Optional, server-side only: your own Ethereum mainnet RPC (Alchemy/Infura/QuickNode). Tried first by /api/rpc; free public RPCs back it up.
ETH_RPC_URL=
# Optional: enables WalletConnect (free project ID from cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server-side only. Funds the on-site "Run new evaluation" button and the CLI script. Use a dedicated GenLayer Studio account.
OPERATOR_PRIVATE_KEY=
