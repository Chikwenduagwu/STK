# GenLayer (Studio) settings are fixed in lib/genlayer/config.ts - no variables needed.

# Ethereum mainnet RPC used by the browser for quotes and balances (strongly recommended)
NEXT_PUBLIC_ETH_RPC_URL=
# Optional: enables WalletConnect (free project ID from cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# CLI only (npm run evaluate). A GenLayer Studio account key. Never set in Vercel.
OPERATOR_PRIVATE_KEY=
